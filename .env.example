# ─── Required ────────────────────────────────────────────────────────────────
# Long random string used to sign logins. Generate one with:  openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Postgres password (used by docker-compose for both the db and the app)
POSTGRES_PASSWORD=change-me-too

# The app's database connection. Inside Docker Compose the host is "db".
# For `npm run dev` on your laptop against the compose database, use localhost:5432 instead.
DATABASE_URI=postgres://slavic:change-me-too@db:5432/slavicsliders

# Public address of the site. Used for SEO tags, sitemaps and share images.
# Start with your server's LAN address, switch to https://your-domain.com later.
SITE_URL=http://192.168.1.50:3000

# ─── Optional: email notifications for contact / sponsor forms ──────────────
# Leave SMTP_HOST empty to skip email. Submissions are always saved in the admin under "Inquiries".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=website@example.com
SMTP_FROM_NAME=Slavic Sliders Website
# Where new inquiries get emailed. Falls back to the contact email in Site Settings.
NOTIFY_EMAIL=

# ─── Optional: Cloudflare Tunnel (see README → "Adding a domain") ───────────
CLOUDFLARE_TUNNEL_TOKEN=
